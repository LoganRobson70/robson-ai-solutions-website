    "qa:measurement:local": "node scripts/measurement-smoke.mjs",
    "qa:measurement:preview": "node scripts/measurement-smoke.mjs --mode=preview --base-url=\"$QA_BASE_URL\"",
    "qa:measurement:evidence": "node scripts/measurement-evidence.mjs"
