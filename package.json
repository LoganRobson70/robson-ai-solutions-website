    "qa:keyboard": "node scripts/keyboard-release-smoke.mjs",
    "qa:keyboard:preview": "node scripts/keyboard-release-smoke.mjs --mode=preview --base-url=\"$QA_BASE_URL\"",
    "qa:rendered": "node scripts/rendered-release-smoke.mjs",
    "qa:rendered:preview": "node scripts/rendered-release-smoke.mjs --mode=preview --base-url=\"$QA_BASE_URL\"",
    "qa:release-inventory": "node scripts/release-candidate-inventory.mjs",
