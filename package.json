    "qa:browser-coverage:strict": "node scripts/browser-coverage-smoke.mjs --strict=true",
    "qa:browser-coverage:preview": "node scripts/browser-coverage-smoke.mjs --mode=preview --base-url=\"$QA_BASE_URL\"",
    "qa:responsive": "node scripts/responsive-route-smoke.mjs",
